# Build output (published as a GitHub release, not in the repository)
/Lampfish.exe
/Lampfish.exe.config
/dist/
__pycache__/

# Downloaded by build.ps1 (WebView2 SDK from NuGet)
app/lib/

# Caches rebuilt on the fly
app/icon-cache/
app/cursor-cache/
app/trash/
app/request.txt

# Personal data: settings, logs, the user's own icons, cursors and sounds
/settings.json
/settings.json.bak
/errors.log
/errors.old.log
/icons/
/cursors/
sounds/log.txt
sounds/My sounds/

# Shortcuts dropped in the wallpaper folder
wallpapers/*.lnk

# Logo production files: only the brand files the app uses are published
brand/inspirations/
brand/badge/*
!brand/badge/powered-by-lampfish-color-dark.png
!brand/badge/powered-by-lampfish-pill.png
src/resources/

# System files
Thumbs.db
desktop.ini

# Wallpapers made or added on this PC
/wallpapers/*/
app/cursor-made/
